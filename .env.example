# Proxy settings (optional - app works without these for local dev)
# For Webshare rotating proxies:
# WEBSHARE_PROXY_USERNAME=your_username
# WEBSHARE_PROXY_PASSWORD=your_password
# WEBSHARE_PROXY_LOCATION=US

# For generic HTTP/HTTPS proxy:
# GENERIC_HTTP_PROXY=http://proxy-host:port
# GENERIC_HTTPS_PROXY=https://proxy-host:port

# Rate limiting
RATE_LIMIT_PER_MINUTE=20

# Cache settings
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=100

# CORS (comma-separated origins, or * for all)
# ALLOWED_ORIGINS=https://your-app.onrender.com

# Port (Render sets this automatically)
# PORT=8000
